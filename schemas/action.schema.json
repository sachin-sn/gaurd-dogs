{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guard-dogs:schema:action:v0",
  "title": "ProposedAction",
  "description": "An action proposed by a guard dog. Investigators only propose; a response gate executes. Levels: 1 observe, 2 alert, 3 contain (reversible, pre-approved policy, with expiry), 4 contain (disruptive, human approval required). Levels 3 and 4 need a panel of at least two votes. Distinct voters are enforced by the response gate, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "proposedBy", "level", "kind", "target", "reason", "evidence", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "proposedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
    "level": { "enum": [1, 2, 3, 4] },
    "kind": {
      "enum": [
        "observe.raise-sampling",
        "alert.notify",
        "contain.rate-limit",
        "contain.block-source",
        "contain.quarantine-file",
        "contain.isolate-service"
      ]
    },
    "target": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "description": "Ids of events and informer records that support the action."
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "reversible": { "type": "boolean" },
    "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "requiresHumanApproval": { "type": "boolean" },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voter", "decision"],
        "properties": {
          "voter": { "type": "string", "minLength": 1, "maxLength": 128 },
          "decision": { "enum": ["approve", "reject", "abstain"] },
          "rationale": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "level": { "enum": [3, 4] } }, "required": ["level"] },
      "then": {
        "required": ["votes"],
        "properties": { "votes": { "type": "array", "minItems": 2 } }
      }
    },
    {
      "if": { "properties": { "level": { "const": 3 } }, "required": ["level"] },
      "then": {
        "required": ["reversible", "ttlSeconds"],
        "properties": { "reversible": { "const": true }, "ttlSeconds": true }
      }
    },
    {
      "if": { "properties": { "level": { "const": 4 } }, "required": ["level"] },
      "then": {
        "required": ["requiresHumanApproval"],
        "properties": { "requiresHumanApproval": { "const": true } }
      }
    }
  ]
}
