{
  "name": "guard-dogs",
  "version": "0.0.1",
  "description": "Guard Dogs: an active patrol layer for web runtimes (Node, PHP) in the AI-attacker era. Research prototype.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachin-sn/gaurd-dogs.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
